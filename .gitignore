# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Stan build artefacts (Phase 3)
*.hpp
src/stan/**/*.exe
.cmdstan/

# Quarto (Phase 5)
/_site/
/.quarto/

# Raw snapshots live on the orphan `data-raw` branch, never on main.
data/raw/*
!data/raw/.gitkeep

# Local scratch
.DS_Store
scratch/

# Compiled Stan executables (built locally / in CI, never committed)
src/wahlwetter/model/stan/*
!src/wahlwetter/model/stan/*.stan

# Model output: 680 KB regenerated on every run, fully reproducible from the
# committed snapshot and a fixed seed. Committing it daily would add hundreds of
# megabytes a year for no benefit; the deploy workflow generates it instead.
data/model/
